# Bu dosyayi ".env" adiyla kopyalayip degerleri doldurun. ".env" asla repoya eklenmez.
# Yayinda (Vercel, Docker, VPS) ayni degiskenler barindirma panelinden/ortamdan verilir.

# --- Zorunlu -----------------------------------------------------------------

# PostgreSQL baglantisi (Neon, Supabase, kendi sunucunuz ...).
DATABASE_URL="postgresql://kullanici:sifre@sunucu:5432/onayapart?sslmode=require"

# Sitenin yayindaki tam adresi (sonunda / olmadan). Site haritasi, canonical
# adresler, WhatsApp/e-posta linkleri ve odeme geri donusu bu adresi kullanir.
NEXT_PUBLIC_SITE_URL="https://onayapart.com"

# Yonetim paneli (/panel) admin sifresi. En az 10 karakter, tahmin edilemez olsun.
# Degistirdiginizde acik tum oturumlar kapanir.
PANEL_PASSWORD=""

# Oturum cerezlerini imzalayan gizli anahtar (en az 32 karakter).
# Uretmek icin:  openssl rand -hex 32
SESSION_SECRET=""

# --- Onerilen ----------------------------------------------------------------

# Takvim senkronu (/api/cron/sync-calendars) icin paylasilan anahtar. Yayinda tanimli
# degilse bu uc nokta kapali kalir. Uretmek icin:  openssl rand -hex 24
CRON_SECRET=""

# --- Istege bagli ------------------------------------------------------------

# Yuklenen fotograf ve evraklarin saklanacagi klasor. Bos birakilirsa proje
# klasorundeki "private-uploads" kullanilir. Docker'da kalici bir volume'e baglayin.
# UPLOAD_DIR="/var/lib/onayapart/uploads"
